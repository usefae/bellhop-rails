<%# A <style> block rather than an asset, so the admin renders the moment the
    engine is mounted and `rails g bellhop:admin` copies it with the views.
    The nonce is set when the application has a Content Security Policy. %>
<%= tag.style nonce: content_security_policy_nonce do %>
/* The bellhop.dev design in plain CSS, since an admin page inside someone
 * else's application cannot assume a build step. The Node example's admin.css
 * is the same sheet; keep them in step.
 *
 * The fonts come from a <link> in the layout, the page's only external
 * request. Delete it and the stacks fall back to Georgia and the system sans.
 */

:root {
  /* Plum for the header, blush for paper, gold for trim, post red for what
     is destructive or urgent, sage for what is well. */
  --plum: #2e1a33;
  --plum-2: #4a2450;
  --plum-3: #6d4a72;
  --plum-fg: #c4aec8;

  --blush: #f7e9e3;
  --blush-2: #efdcd4;
  --paper: #fffbf7;

  --gold: #b8912e;
  --gold-2: #e3c46a;

  --post: #b3232b;
  --post-soft: #f6e2e2;
  --post-rule: #e4b9b9;

  --sage: #4e6b52;
  --sage-soft: #e6eee7;

  --ink: #2b2028;
  --muted: #7c6b76;
  --rule: #e4d3cb;

  --display: "Libre Caslon Display", Georgia, "Times New Roman", serif;
  --sans: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
  --mono: "Courier Prime", ui-monospace, SFMono-Regular, Menlo, monospace;

  /* Light only. A dark version would be a different design. */
  color-scheme: light;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--blush);
  color: var(--ink);
  font: 15px/1.6 var(--sans);
  -webkit-font-smoothing: antialiased;
}

::selection {
  background: var(--gold-2);
  color: var(--plum);
}

:focus-visible {
  outline: 2px solid var(--post);
  outline-offset: 3px;
}

a {
  color: var(--post);
  font-weight: 600;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

h1,
h2,
h3,
p {
  margin: 0;
}

code {
  font-family: var(--mono);
  font-size: 13px;
}

pre {
  margin: 0;
  padding: 12px 14px;
  overflow-x: auto;
  border: 1px solid var(--rule);
  border-radius: 2px;
  background: var(--blush-2);
  font-family: var(--mono);
  font-size: 13px;
}

/* --- The frame ------------------------------------------------------------ */

/* Every band runs full bleed and centres its own content. */
.wrap {
  width: 100%;
  max-width: 1024px;
  margin: 0 auto;
  padding: 0 24px;
}

.hdr {
  background: var(--plum);
  color: var(--blush);
}

.hdr-in {
  display: flex;
  align-items: center;
  gap: 22px;
  height: 60px;
}

.mark {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-weight: 400;
  text-decoration: none;
}

.mark:hover {
  text-decoration: none;
}

.mark svg {
  width: 24px;
  height: 24px;
  color: var(--gold-2);
}

.mark span {
  font: 400 25px/1 var(--display);
}

/* "Agent admin", "Node example". */
.hdr-tag {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gold-2);
}

.hdr-link {
  margin-left: auto;
  color: var(--plum-fg);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  transition: color 0.15s;
}

.hdr-link:hover {
  color: #fff;
  text-decoration: none;
}

/* The gold rule under the header. */
.braid {
  height: 6px;
  border-top: 2px solid var(--gold);
  border-bottom: 1px solid var(--gold-2);
  background: var(--plum-2);
}

/* What the server was configured with. Nothing here is editable. */
.facts {
  border-bottom: 1px solid var(--rule);
  background: var(--blush-2);
}

.facts-in {
  display: flex;
  flex-wrap: wrap;
}

/* Baseline-aligned: the display face sits low in its line box, and centring
   leaves the small-caps label riding above the value. */
.fact {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-right: 24px;
  padding: 12px 24px 12px 0;
  border-right: 1px solid var(--rule);
}

.fact:last-child {
  margin-right: 0;
  padding-right: 0;
  border-right: 0;
}

.fact-value {
  font: 400 18px/1.2 var(--display);
}

.fact-value.mono {
  font: 400 13px/1.5 var(--mono);
}

.fact-note {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 13px;
}

main {
  padding-bottom: 28px;
}

.foot {
  padding-top: 36px;
  padding-bottom: 44px;
  color: var(--muted);
  font-size: 12px;
  text-align: center;
}

.foot em {
  font-style: italic;
}

/* --- Type ----------------------------------------------------------------- */

.display {
  font-family: var(--display);
  font-weight: 400;
}

.page-title {
  font: 400 38px/1.15 var(--display);
}

/* Small caps, tracked wide: every label on the page is set this way. */
.caps {
  color: var(--muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}

.sub {
  color: var(--muted);
  font-size: 14px;
}

.mono {
  font-family: var(--mono);
}

/* A section heading on a heavy rule, with anything else on the line at the
   right end. */
.section {
  padding-top: 32px;
}

.section-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4px 16px;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1.5px solid var(--plum);
}

.section-head h2 {
  font: 400 27px/1 var(--display);
}

.section-head .caps {
  margin-left: auto;
}

/* --- A page that is one thing --------------------------------------------- */

/* Pairing and its failures: one subject, set narrow. Spacing lives here so no
   view needs a `style` attribute, which a Content Security Policy blocks. */
.page {
  max-width: 560px;
  padding-top: 32px;
}

.page-title + .sub {
  margin-top: 10px;
}

.sub + .sheet,
.sub + .paper {
  margin-top: 22px;
}

.caps + .row,
.caps + .response {
  margin-top: 10px;
}

.response {
  font-family: var(--mono);
}

.response + p {
  margin-top: 12px;
}

.sheet-cta {
  margin-top: 18px;
}

.page-back {
  margin-top: 20px;
}

/* The add-an-agent form, under the register it adds to. */
.paper + .paper {
  margin-top: 14px;
}

.dim {
  color: var(--muted);
}

/* --- Paper ---------------------------------------------------------------- */

.paper {
  overflow: hidden;
  border: 1px solid var(--rule);
  border-radius: 2px;
  background: var(--paper);
}

.paper-pad {
  padding: 20px;
}

/* A sheet for something shown once, with the same double rule bellhop.dev
   gives a secret key. */
.sheet {
  position: relative;
  padding: 24px;
  border: 1px solid var(--rule);
  border-radius: 2px;
  background: var(--paper);
}

.sheet::before {
  content: "";
  position: absolute;
  inset: 6px;
  border: 1px solid var(--post);
  opacity: 0.25;
  pointer-events: none;
}

.sheet > * {
  position: relative;
}

.notice {
  margin: 24px 0 0;
  padding: 12px 16px;
  border: 1px solid;
  border-radius: 2px;
  font-size: 14px;
}

.notice-alert {
  border-color: var(--post-rule);
  background: var(--post-soft);
  color: var(--post);
}

.notice-good {
  border-color: var(--sage);
  background: var(--sage-soft);
  color: var(--sage);
}

/* --- The register --------------------------------------------------------- */

/* Scrolls inside its own paper rather than squeezing the columns. */
.scroll {
  overflow-x: auto;
}

.register {
  width: 100%;
  min-width: 620px;
  border-collapse: collapse;
}

/* Nine columns fit inside the wrap, but only on tighter gutters than the job
   table. */
.register-wide {
  min-width: 940px;
}

.register th {
  padding: 10px 12px;
  border-bottom: 1.5px solid var(--plum);
  background: var(--blush-2);
  color: var(--muted);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.17em;
  text-align: left;
  text-transform: uppercase;
  white-space: nowrap;
}

.register td {
  height: 50px;
  padding: 8px 12px;
  border-bottom: 1px solid var(--rule);
  vertical-align: middle;
}

.register tbody tr:last-child td {
  border-bottom: 0;
}

.register tbody tr:hover {
  background: color-mix(in srgb, var(--blush-2) 40%, transparent);
}

.register .right {
  text-align: right;
}

.register .tight {
  width: 1px;
  padding-right: 4px;
}

/* Fixed: auto table layout measures a wrapping flex row at its widest single
   item, which would fold four actions onto four lines. */
.register .col-actions {
  width: 152px;
}

/* The line number, in gold. A register counts its entries. */
.numeral {
  color: var(--gold);
  font: 400 23px/1 var(--display);
}

.numeral.spent {
  color: var(--muted);
}

.entry {
  font-size: 14px;
  font-weight: 600;
}

.entry-note {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 11.5px;
}

/* "Windows 11" broken across two lines reads as two facts. */
.entry-note.nowrap {
  white-space: nowrap;
}

.cell-date {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 12px;
  white-space: nowrap;
}

.cell-list {
  font-size: 13px;
}

.cell-error {
  color: var(--post);
  font-size: 13px;
}

/* A note the register itself makes, along its bottom edge. */
.register-note {
  margin: 0;
  padding: 12px 16px;
  border-top: 1.5px solid var(--plum);
  background: var(--blush-2);
  color: var(--muted);
  font-size: 12px;
}

.empty {
  padding: 40px 16px;
  color: var(--muted);
  font-size: 14px;
  text-align: center;
}

/* --- Seals ---------------------------------------------------------------- */

/* A status carries a coloured pip, drawn from the text colour so the two
   cannot disagree. */
.seal {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  white-space: nowrap;
}

.seal::before {
  content: "";
  flex: none;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}

.seal-good {
  color: var(--sage);
}

.seal-idle {
  color: var(--muted);
}

.seal-wait {
  color: var(--gold);
}

.seal-bad {
  color: var(--post);
}

/* --- Controls ------------------------------------------------------------- */

button,
input,
select {
  font-family: inherit;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 16px;
  border: 1px solid var(--plum);
  border-radius: 2px;
  background: none;
  color: var(--plum);
  font: 600 11px/1 var(--sans);
  letter-spacing: 0.13em;
  text-transform: uppercase;
  white-space: nowrap;
  cursor: pointer;
  transition:
    background-color 0.15s,
    border-color 0.15s,
    color 0.15s;
}

.btn:hover {
  background: var(--plum);
  color: var(--blush);
  text-decoration: none;
}

.btn:disabled {
  opacity: 0.3;
  pointer-events: none;
}

.btn-gold {
  border-color: var(--gold);
  background: var(--gold);
  color: var(--plum);
}

.btn-gold:hover {
  border-color: var(--gold-2);
  background: var(--gold-2);
  color: var(--plum);
}

.btn-post {
  border-color: var(--post);
  color: var(--post);
}

.btn-post:hover {
  background: var(--post);
  color: #fff;
}

.btn-quiet {
  border-color: transparent;
  color: var(--muted);
}

.btn-quiet:hover {
  border-color: var(--post);
  background: none;
  color: var(--post);
}

.btn-sm {
  padding: 5px 9px;
  font-size: 10px;
  letter-spacing: 0.12em;
}

/* A row action: quiet until you look at it. */
.row-action {
  padding: 0;
  border: 0;
  border-bottom: 1px solid transparent;
  background: none;
  color: var(--post);
  font: 600 9.5px/1.6 var(--sans);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
}

.row-action:hover {
  border-bottom-color: var(--post);
}

/* Re-pairing moves an agent rather than ending it, so it is quieter still. */
.row-action-quiet {
  color: var(--muted);
}

.row-action-quiet:hover {
  border-bottom-color: var(--post);
  color: var(--post);
}

/* button_to and a plain form each wrap their button in a <form>; `display:
   contents` drops the forms out of the box tree so the buttons themselves are
   the flex items. Printing sits on the first line as buttons and the standing
   actions on the second as text, which reads as a hierarchy rather than as a
   ragged wrap, and keeps the column from pushing the register off the page. */
.actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 6px 10px;
  max-width: 148px;
  margin-left: auto;
}

.actions form {
  display: contents;
}

/* Breaks the line between the buttons and the text actions, whether there are
   one or two of each. */
.actions-break {
  flex-basis: 100%;
  height: 0;
}

.field {
  display: block;
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--rule);
  border-radius: 2px;
  background: #fff;
  color: var(--ink);
  font: 400 15px/1.4 var(--sans);
}

.field:focus {
  outline: 2px solid var(--post);
  outline-offset: -1px;
}

.field-mono {
  font-family: var(--mono);
  font-size: 13.5px;
}

.field-label {
  display: block;
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}

.field-note {
  margin-top: 6px;
  color: var(--muted);
  font-size: 12px;
}

/* One line: a field that grows and a button that does not. */
.row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.row .field {
  flex: 1 1 220px;
  width: auto;
}

/* --- Narrow screens ------------------------------------------------------- */

@media (max-width: 640px) {
  .wrap {
    padding: 0 16px;
  }

  .hdr-in {
    gap: 14px;
  }

  .hdr-tag {
    display: none;
  }

  .page-title {
    font-size: 30px;
  }

  .section-head h2 {
    font-size: 23px;
  }
}
<% end %>
